# Copy to .env and adjust. All settings are optional.

# --- engines (use "mock" to run the UI without any models)
KONTHO_TTS_ENGINE=omnivoice          # omnivoice | mock
KONTHO_STT_ENGINE=whisper            # whisper | mock
KONTHO_ISOLATION_ENGINE=demucs       # demucs | mock
KONTHO_TRANSLATE_ENGINE=nllb         # nllb | llm | mock
KONTHO_SFX_ENGINE=audioldm2          # audioldm2 | stable-audio | mock
KONTHO_DEVICE=auto                   # auto | cuda | cpu | mps

# --- models
KONTHO_OMNIVOICE_MODEL=k2-fsa/OmniVoice
KONTHO_WHISPER_MODEL=large-v3-turbo  # tiny | base | small | medium | large-v3 | large-v3-turbo
KONTHO_DEMUCS_MODEL=htdemucs
KONTHO_NLLB_MODEL=facebook/nllb-200-distilled-600M
KONTHO_SFX_MODEL=cvssp/audioldm2     # or stabilityai/stable-audio-open-1.0 (gated: needs HF_TOKEN)

# --- LLM translation (KONTHO_TRANSLATE_ENGINE=llm): any OpenAI-compatible server
KONTHO_LLM_BASE_URL=http://localhost:11434/v1   # Ollama
KONTHO_LLM_MODEL=qwen2.5:7b-instruct
KONTHO_LLM_API_KEY=ollama

# Hugging Face token for gated models (pyannote diarization, Stable Audio Open)
HF_TOKEN=

# --- security: require an API key (xi-api-key header) on every /v1 request
KONTHO_AUTH=false
KONTHO_ADMIN_KEY=change-me-to-a-long-random-string
KONTHO_CORS_ORIGINS=*

# --- server
KONTHO_WORKERS=1           # parallel background jobs (keep 1 on a single GPU)
KONTHO_MAX_UPLOAD_MB=500
